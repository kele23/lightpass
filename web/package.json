{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:cf": "cp .env .dev.vars && npx wrangler dev --config .output/server/wrangler.json .output/server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "openapi-ts --client xhr --input ./api-swagger.json --output ./src/api --base ''",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@vueuse/core": "^14.2.1",
    "@vueuse/router": "^14.2.1",
    "consola": "^3.4.2",
    "date-fns": "^4.1.0",
    "events": "^3.3.0",
    "jose": "^6.2.2",
    "nitro": "3.0.260311-beta",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "pouchdb-browser": "^9.0.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.94.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/papaparse": "^5.5.2",
    "@types/pouchdb-browser": "^6.1.5",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "daisyui": "^5.5.19",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "pouchdb-browser@9.0.0": "patches/pouchdb-browser.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
